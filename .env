# ==========================================
# Zoryx Telegram Mini App
# .env
# ==========================================

# ==========================================
# Server
# ==========================================

PORT=3000
NODE_ENV=production


# ==========================================
# Telegram Bot
# ==========================================

BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN
BOT_USERNAME=YOUR_BOT_USERNAME


# ==========================================
# MongoDB
# ==========================================

MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority&appName=Cluster0

DB_NAME=zoryx


# ==========================================
# Energy
# ==========================================

DEFAULT_ENERGY=1000
MAX_ENERGY=1000
ENERGY_RESTORE_TIME=4000


# ==========================================
# Daily Reward
# ==========================================

DAILY_RESET_HOUR=5
DAILY_RESET_MINUTE=0
TIMEZONE=GMT


# ==========================================
# Referral
# ==========================================

REFERRAL_ENERGY_1=3000
REFERRAL_ENERGY_3=15000
REFERRAL_ENERGY_5=25000

REFERRAL_COIN_10=500000
REFERRAL_COIN_20=500000
REFERRAL_COIN_30=500000
REFERRAL_COIN_50=500000
REFERRAL_COIN_100=500000
REFERRAL_COIN_200=500000
REFERRAL_COIN_300=500000
REFERRAL_COIN_500=500000


# ==========================================
# Lucky Spin
# ==========================================

SPIN_MIN=1000
SPIN_MAX=250000
